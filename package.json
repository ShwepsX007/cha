    "verify": "npm run typecheck && npm run lint && npm run db:check",
    "smoke": "node scripts/smoke-test.mjs",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "dotenv": "17.3.1",
