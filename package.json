{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "admin-bot": "tsx scripts/admin-bot.ts",
    "db:setup": "node scripts/db-setup.mjs",
