# PostgreSQL connection for the chat app. Create a separate DB/user for this app.
DATABASE_URL=postgresql://chata_app:CHANGE_ME@127.0.0.1:5432/chata_db

# Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_HEX_SECRET

# Optional: needed only for uploading and downloading chat attachments through Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Telegram owner/admin bootstrapping. If BOT_OWNER_TELEGRAM_ID is set,
# the included Node script will only respond to that Telegram user and can
# create/rotate a local app admin account.
BOT_OWNER_TELEGRAM_ID=
# Matrix/Synapse E2EE. Leave these unset until a homeserver is deployed.
# The public URL must be reachable by browsers; the internal URL is used by Next.js.
MATRIX_PUBLIC_URL=
MATRIX_INTERNAL_URL=
MATRIX_SERVER_NAME=
# Keep this server-side only. Never expose it with a NEXT_PUBLIC_ prefix.
MATRIX_ADMIN_ACCESS_TOKEN=

# Web Push (optional). Generate a pair once with:
#   npx web-push generate-vapid-keys
# and set VAPID_PUBLIC_KEY as NEXT_PUBLIC_VAPID_PUBLIC_KEY too (browsers need it).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
