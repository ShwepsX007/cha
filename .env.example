# PostgreSQL connection for the chat app. Create a separate DB/user for this app.
DATABASE_URL=postgresql://chata_app:CHANGE_ME@127.0.0.1:5432/chata_db

# Generate with: openssl rand -hex 32
# The app refuses to start handling requests in production without this value.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_HEX_SECRET

# Optional. Promote this username to admin on login only while the database has
# no admins yet (bootstrap). Leave empty to rely on "first registered user
# becomes admin" instead.
INITIAL_ADMIN_IDENTIFIER=

# Optional: where runtime uploads (avatars) are stored. Defaults to ./.data
# Keep it outside public/ and make sure it is writable by the pm2 user.
UPLOAD_DIR=

# Optional: PostgreSQL pool size per app process (default 10).
DATABASE_POOL_MAX=10

# Optional: needed only for uploading and downloading chat attachments through Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Telegram owner/admin bootstrapping. If BOT_OWNER_TELEGRAM_ID is set,
# the included Node script will only respond to that Telegram user and can
# create/rotate a local app admin account.
BOT_OWNER_TELEGRAM_ID=

# Matrix/Synapse E2EE. All four values must be set together, or E2EE stays
# disabled and private chats cannot be created. Leave empty until a homeserver
# is deployed.
# The public URL must be reachable by browsers; the internal URL is used by Next.js.
MATRIX_PUBLIC_URL=
MATRIX_INTERNAL_URL=
MATRIX_SERVER_NAME=
# Keep this server-side only. Never expose it with a NEXT_PUBLIC_ prefix.
MATRIX_ADMIN_ACCESS_TOKEN=
# Optional: request Matrix refresh tokens at login. Leave OFF.
# With refresh tokens Synapse issues access tokens that expire after
# `refreshable_access_token_lifetime` (5 minutes by default), which is what made
# the browser lose its Matrix session on almost every reload. Revoking a device
# here is explicit (profile settings / admin panel), so long-lived tokens are
# safe. Turn this on only together with `refreshable_access_token_lifetime` set
# to something long (days) in homeserver.yaml - the app then rotates tokens
# automatically and persists them across tabs.
MATRIX_REFRESH_TOKENS=

# Web Push (optional). Generate a pair once with:
#   npx web-push generate-vapid-keys
# All three values are required - push stays disabled if VAPID_EMAIL is empty.
# VAPID_EMAIL must be a mailto: or https: URL (a bare address is normalized to
# mailto:, anything else makes web-push throw before the first send).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com
# Optional. Only needed if the client cannot read the key from /api/push/subscribe.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
